<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1319"
    tools:context=".vad.asr.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HLAVICKA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speak-o"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <Button
                android:id="@+id/btn_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="⋮"
                android:textColor="#E8ECF5"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- STAV -->
        <TextView
            android:id="@+id/status_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@null" android:background="@drawable/card"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="pripravene"
            android:textColor="#8A93A6"
            android:textSize="12sp" />

        <!-- PREPINAC REZIMU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_mode1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/seg_on"
                android:text="Prepis"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/seg_off"
                android:text="Preklad"
                android:textColor="#C7D0DE"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_mode3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/seg_off"
                android:text="Nahrávka"
                android:textColor="#C7D0DE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- EDITOR (zdieľaný: prepis + originál prekladu) -->
        <EditText
            android:id="@+id/my_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:backgroundTint="@null" android:background="@drawable/card"
            android:gravity="top|start"
            android:hint="Diktovany text..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="#E8ECF5"
            android:textColorHint="#5C6478"
            android:textSize="17sp" />

        <!-- PREKLAD -->
        <TextView
            android:id="@+id/translate_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PREKLAD"
            android:textColor="#7FB3D9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/translate_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:backgroundTint="@null" android:background="@drawable/card_alt"
            android:gravity="top|start"
            android:hint="Preklad..."
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="#BBD7F0"
            android:textColorHint="#40566B"
            android:textSize="17sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/trans_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_trans_now"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_primary"
                android:text="Preložiť"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_trans_copy"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                android:text="Kopírovať"
                android:textColor="#E8ECF5"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_trans_send"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                android:text="Poslať"
                android:textColor="#E8ECF5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- NAHRAVKY -->
        <LinearLayout
            android:id="@+id/records_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rec_pick"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="@null" android:background="@drawable/btn_primary"
                    android:text="Vybrať súbor"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/rec_refresh"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                    android:text="Obnoviť"
                    android:textColor="#E8ECF5"
                    android:textSize="13sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_records"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:divider="#0F1319"
                android:dividerHeight="6dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- VELKE KRUHOVE NAHRAVANIE (len prepis) -->
        <Button
            android:id="@+id/record_button"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:backgroundTint="@null" android:background="@drawable/mic_on"
            android:text="NAHRÁVAŤ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- HLAVNE AKCIE (len prepis) -->
        <LinearLayout
            android:id="@+id/main_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/act_send"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_primary"
                android:text="Posli"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/act_dellast"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                android:text="Veta"
                android:textColor="#E8ECF5"
                android:textSize="14sp" />

            <Button
                android:id="@+id/act_clear"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_danger"
                android:text="Všetko"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/act_copy"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@null" android:background="@drawable/btn_neutral"
                android:text="Kopír."
                android:textColor="#E8ECF5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 8 KONFIGUROVATELNYCH (len prepis) -->
        <LinearLayout
            android:id="@+id/btn_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B1" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_2" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B2" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_3" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B3" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_4" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B4" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B5" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_6" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B6" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_7" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B7" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/btn_8" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_weight="1" android:backgroundTint="@null" android:background="@drawable/btn_neutral" android:text="B8" android:textColor="#B9C2D4" android:textSize="11sp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
